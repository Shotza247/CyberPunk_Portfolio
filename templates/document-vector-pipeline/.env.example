# Runtime
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8765
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=project_rag
MONGODB_COLLECTION=document_chunks
VECTOR_INDEX_NAME=document_vector_index
VECTOR_FIELD=embedding
VECTOR_DIMENSIONS=1024
VECTOR_NUM_CANDIDATES=150

# Embeddings: voyage | openai | hashing
EMBEDDING_PROVIDER=voyage
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-context-4
RERANK_PROVIDER=voyage
VOYAGE_RERANK_MODEL=rerank-2.5
RERANK_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generative chat model for LangChain/LangGraph (Voyage is not a chat provider)
CHAT_PROVIDER=openai
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=700
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Independent Streamlit API-client smoke test
RAG_API_URL=http://127.0.0.1:8767
RAG_TEST_DATABASE=RAG_with_MongoDB
RAG_TEST_COLLECTION=mvp1_template_smoke_chunks
